        <!-- Core Math Engine -->
        <mxCell id="engine-box" value="Core PERT/CPM Algorithmic Engine (pert_engine.py)&#xa;&#xa;1. Input &amp; DAG Validation:&#xa;   • O &lt;= M &lt;= P and O &gt; 0 checks&#xa;   • 3-Color DFS Cycle Detection (Acyclic verification)&#xa;&#xa;2. CPM Forward &amp; Backward Passes:&#xa;   • Kahn&#39;s Topological Sorting&#xa;   • ES, EF, LS, LF, Float/Slack&#xa;   • Multiple Critical Paths Identification (Zero Slack)&#xa;&#xa;3. Risk &amp; Normal CDF Statistics:&#xa;   • Expected Time TE = (O + 4M + P) / 6&#xa;   • Variance V = ((P - O) / 6)^2 (Full Float Precision)&#xa;   • Z-Score &amp; math.erf Completion Probability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#06b6d4;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="container-group">
          <mxGeometry x="400" y="70" width="320" height="360" as="geometry" />
        </mxCell>

