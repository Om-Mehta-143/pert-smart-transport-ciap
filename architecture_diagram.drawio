        <mxCell id="security-layer" value="Defense-in-Depth Gateway&#xa;• Security Headers (CSP, X-Frame DENY, nosniff)&#xa;• 1MB Payload Cap (MAX_CONTENT_LENGTH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#2563eb;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="container-group">
          <mxGeometry x="40" y="70" width="280" height="70" as="geometry" />
