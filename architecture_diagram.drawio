        <!-- Flask Routing Layer -->
        <mxCell id="flask-app" value="Flask Web Controller (app.py)&#xa;• GET / (Main Dashboard)&#xa;• GET /sdg (SDG 9 &amp; 11 Page)&#xa;• GET /health (Liveness Probe)&#xa;• POST /api/calculate&#xa;• POST /api/probability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#4b5563;fontColor=#ffffff;fontSize=11;" vertex="1" parent="container-group">
